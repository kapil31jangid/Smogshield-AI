# SmogShield AI - Environment Variables
# Copy to .env.local and fill in your values

# Firebase Configuration (Client-side - safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Firebase Admin (Server-side only - NEVER expose to client)
# Generate service account JSON from Firebase Console > Project Settings > Service Accounts
# Then base64 encode: cat service-account.json | base64 -w0
FIREBASE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json

# GenAI - Google Gemini (Server-side only)
GEMINI_API_KEY=your_gemini_api_key

# AQI Data Providers (Server-side only)
# OpenAQ - https://openaq.org/ (free tier: 100 req/min)
OPENAQ_API_KEY=your_openaq_api_key

# WAQI / AQICN - https://aqicn.org/api/ (free tier: 1000 req/day)
WAQI_API_KEY=your_waqi_api_key

# Email Notifications (Optional - Brevo/Sendinblue)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Cron Security (Server-side only)
# Generate: openssl rand -hex 32
CRON_SECRET=your_cron_secret_32_chars_min

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (for development without API keys)
NEXT_PUBLIC_DEMO_MODE=true