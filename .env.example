# ============================================================================
# SmogShield AI — Environment Variables Template
# Copy to .env.local for local development. NEVER commit real secrets.
# ============================================================================

# 1. Firebase Web SDK Configuration (Project: smogshield-ai-kapil)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=smogshield-ai-kapil.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smogshield-ai-kapil
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smogshield-ai-kapil.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=609090729839
NEXT_PUBLIC_FIREBASE_APP_ID=1:609090729839:web:2b8cce908b660935a0da9a

# 2. Firebase Server / Firestore Configuration
FIREBASE_PROJECT_ID=smogshield-ai-kapil
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_REGION=asia-south1

# 3. Official Indian Air Quality Station Providers (Optional Tier 1)
# When configured, SmogShield AI queries official CPCB continuous monitoring
# station telemetry first before falling back to Open-Meteo Copernicus CAMS.
CPCB_DATA_GOV_API_KEY=your_data_gov_in_cpcb_api_key_here
WAQI_API_TOKEN=your_waqi_station_api_token_here

# 4. GenAI Family Assistant Provider (Optional Server-Side Gemini Key)
# When configured, powers conversational Gemini 2.0 Flash / 1.5 Flash answers
# grounded in validated environmental context and deterministic safety rules.
# When omitted, the assistant automatically uses the Deterministic Rule-Grounded
# Bilingual Responder (EN/HI) with zero disruption.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 5. Application URL (Used for metadata & HTTP verification)
NEXT_PUBLIC_APP_URL=http://localhost:3000
